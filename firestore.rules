rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Landing Page Configuration (Public read, write)
    match /landing_config/{configId} {
      allow read, write: if isValidId(configId);
    }

    // Leads Collection (Commercial inquiries)
    match /leads/{leadId} {
      allow read, write: if isValidId(leadId);
    }

    // History of Saved Changes
    match /page_changes/{changeId} {
      allow read, write: if isValidId(changeId);
    }

    // Travel Requests Collection (Solicitações de Viagens dos Funcionários em Tempo Real)
    match /travel_requests/{requestId} {
      allow read, write: if isValidId(requestId);
    }

    // Employees Collection (Funcionários Cadastrados na Plataforma)
    match /employees/{employeeId} {
      allow read, write: if isValidId(employeeId);
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
